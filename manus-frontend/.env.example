# Existing FastAPI service. The frontend adapter reads this at runtime.
VITE_API_BASE_URL=http://localhost:8000

# Set false to require live API wiring instead of preview records.
VITE_USE_DEMO_DATA=true

# Optional local demo-only access labels. Never commit real credentials.
VITE_DEMO_COORDINATOR_EMAIL=coordinator@example.local
VITE_DEMO_COORDINATOR_PASSWORD=demo-only
